#!/bin/bash
# Startet den lokalen Portfolio-Editor-Server (falls nicht schon aktiv) und öffnet Firefox.
# Liegt in Portfolio-Editor.app/Contents/MacOS/ -> Projektordner ist drei Ebenen höher.
PROJECT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
PORT="${EDITOR_PORT:-4466}"

NODE="$(command -v node)"
if [ -z "$NODE" ]; then
  osascript -e 'display dialog "Node.js wurde nicht gefunden.\n\nBitte Node.js installieren (https://nodejs.org) und erneut versuchen." buttons {"OK"} default button "OK" with icon stop with title "Portfolio-Editor"'
  exit 1
fi

# Nicht in den Projektordner wechseln (macOS-TCC kann der App den Desktop-cwd verweigern -> EPERM).
cd / || exit 1

if ! curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  EDITOR_PORT="$PORT" nohup "$NODE" "$PROJECT_DIR/editor/server.mjs" >/tmp/portfolio-editor.log 2>&1 &
  for i in $(seq 1 60); do
    curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 0.2
  done
fi

if ! curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  osascript -e 'display dialog "Der Editor-Server konnte nicht gestartet werden.\n\nDetails: /tmp/portfolio-editor.log" buttons {"OK"} default button "OK" with icon stop with title "Portfolio-Editor"'
  exit 1
fi

URL="http://127.0.0.1:$PORT/"
# Firefox bevorzugt (Stiftdruck funktioniert dort), sonst Standardbrowser.
if ! open -a "Firefox" "$URL" 2>/dev/null; then
  open "$URL"
fi
